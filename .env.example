# Copy to .env for local development (never commit .env). Placeholders only — no real values here.

# production | demo | development  (on Render it defaults to production)
APP_ENV=development

# Neon PostgreSQL. Required in production and demo; leave empty in development to use data/reroute.db (SQLite).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# true (default) = seeded demo accounts, one-click demo login (never admin), on-screen prototype OTP.
# Set false for a real launch.
ENABLE_DEMO_MODE=true

# Password for the seeded demo admin (01300000000) on demo/development deployments only. Min 10 characters.
DEMO_ADMIN_PASSWORD=

# Demo deployments only: rebuild idle demo data every DEMO_TTL_HOURS
DEMO_AUTO_REFRESH=false
DEMO_TTL_HOURS=12

# Comma-separated origins allowed to call the API from another website (the app itself needs none)
ALLOWED_ORIGINS=

# Reverse proxies in front of the app that append to X-Forwarded-For (Render: 1, local: 0)
TRUSTED_PROXIES=0

# Days a login stays valid
SESSION_DAYS=7
